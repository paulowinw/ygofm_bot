# ==============================================================================
# Yu-Gi-Oh! Forbidden Memories Online Auto-Dueler (YGBot)
# Environment Configuration Template (.env.example)
# Copy to .env: cp .env.example .env
# ==============================================================================

# Target Game Website
GAME_URL="https://ygofm.com/"
TARGET_URL_PATTERN="ygofm.com"
ALT_URL_PATTERN="intercityygo.com"

# Chrome Remote Debugging Settings
CHROME_HOST="127.0.0.1"
CHROME_PORT=9222
CHROME_BINARY="google-chrome"
CHROME_USER_DATA_DIR="$HOME/.config/ygbot-chrome"
AUTO_LAUNCH=false

# Duel & Farming Settings
OPPONENT="High Mage Martis"
MAX_DUELS=0
STRATEGY="THTD"
GUARDIAN_STAR="Pluto"
ACTION_DELAY=0.5
TURN_WAIT=1.5
COMBAT_WAIT=2.0
LOADING_TIMEOUT=30.0
